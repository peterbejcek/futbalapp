# Build stage — Debian slim (Prisma engine má na glibc oficiálnu podporu)
FROM node:22-slim AS build
# openssl už v build fáze — prisma generate podľa neho deteguje binaryTarget
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@10.33.0
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile --filter @fkknv/api... --filter @fkknv/shared...
RUN pnpm --filter @fkknv/shared build && pnpm --filter @fkknv/api build

# Runtime stage — bez pnpm/corepack: pri štarte sa nič nesťahuje z internetu
FROM node:22-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
COPY --from=build /repo /repo
WORKDIR /repo/apps/api
EXPOSE 3001
# npx tu nič nesťahuje — spúšťa lokálne nainštalovanú prisma CLI
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main.js"]
