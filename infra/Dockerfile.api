# Build stage
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile --filter @fkknv/api... --filter @fkknv/shared...
RUN pnpm --filter @fkknv/shared build && pnpm --filter @fkknv/api build

# Runtime stage
FROM node:22-alpine
RUN corepack enable
WORKDIR /repo
ENV NODE_ENV=production
COPY --from=build /repo ./
EXPOSE 3001
CMD ["sh", "-c", "pnpm --filter @fkknv/api db:deploy && node apps/api/dist/main.js"]
