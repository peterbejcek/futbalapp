# Produkčné premenné pre infra/docker-compose.yml.
# Skopírujte na infra/.env, vyplňte a nastavte práva 600:
#   cp .env.example .env && chmod 600 .env
# Súbor .env sa NIKDY necommituje (je v .gitignore aj .dockerignore).

# Heslo k PostgreSQL databáze — silné, min. 16 znakov.
POSTGRES_PASSWORD=

# Tajný kľúč pre JWT tokeny aj CAPTCHA — náhodný, min. 32 znakov.
# Vygenerovať:  openssl rand -base64 48
JWT_SECRET=

# (voliteľné) E-maily cez Resend — upomienky dlžníkom. Bez kľúča sa e-maily
# iba zalogujú a appka funguje ďalej. Doplniť po overení domény na resend.com.
RESEND_API_KEY=
EMAIL_FROM=FK Košická Nová Ves <noreply@fkknv.sk>

# (voliteľné) Veo — automatické hľadanie videa zo zápasu (developer.veo.co.uk).
# Client ID vydáva Veo na požiadanie; Username/Password je klubový Veo účet.
# Bez týchto premenných ostáva pri videu len manuálne vloženie odkazu.
VEO_CLIENT_ID=
VEO_USERNAME=
VEO_PASSWORD=

# (voliteľné) ISSF — synchronizácia zoznamu hráčov klubu (issf.futbalsfz.sk).
# Prihlasovacie údaje klubového ISSF manažéra. Bez nich je synchronizácia vypnutá.
# *_URL sú voliteľné (predvolené hodnoty mieria na ISSF zoznam hráčov klubu).
ISSF_USERNAME=
ISSF_PASSWORD=
ISSF_PLAYERS_URL=
ISSF_LOGIN_URL=
# ISSF_DEBUG=1 → do logov vypíše aj úryvok HTML stiahnutej stránky (na ladenie)
ISSF_DEBUG=
