# Build stage
FROM node:22-slim AS build
RUN npm install -g pnpm@10.33.0
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY packages ./packages
COPY apps/web ./apps/web
RUN pnpm install --frozen-lockfile --filter @fkknv/web... --filter @fkknv/shared...

# NEXT_PUBLIC_* premenné sa zapekajú do klientskeho bundle-u pri builde
ARG NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN pnpm --filter @fkknv/shared build && pnpm --filter @fkknv/web build

# Runtime stage — bez pnpm: next sa spúšťa priamo z node_modules
FROM node:22-slim
ENV NODE_ENV=production
COPY --from=build /repo /repo
WORKDIR /repo/apps/web
EXPOSE 3000
CMD ["npx", "next", "start", "--port", "3000"]
