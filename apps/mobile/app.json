{
  "expo": {
    "name": "FK Košická Nová Ves",
    "slug": "fkknv",
    "scheme": "fkknv",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#16223c"
    },
    "ios": {
      "bundleIdentifier": "sk.fkknv.app",
      "supportsTablet": false
    },
    "android": {
      "package": "sk.fkknv.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16223c"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#16223c"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.fkknv.sk/api/v1"
    }
  }
}
