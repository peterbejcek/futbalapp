{
  "expo": {
    "name": "FK KNV",
    "slug": "fkknv",
    "scheme": "fkknv",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/f79e91e9-bd0c-4900-ae53-37821748c371",
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#16223c"
    },
    "ios": {
      "bundleIdentifier": "sk.fkknv.app",
      "supportsTablet": false
    },
    "android": {
      "package": "sk.fkknv.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16223c"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#16223c"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.fkknv.sk/api/v1",
      "router": {},
      "eas": {
        "projectId": "f79e91e9-bd0c-4900-ae53-37821748c371"
      }
    },
    "owner": "petobejos-team"
  }
}
