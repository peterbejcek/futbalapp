{
  "expo": {
    "name": "FK Košická Nová Ves",
    "slug": "fkknv",
    "scheme": "fkknv",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#16223c"
    },
    "ios": {
      "bundleIdentifier": "sk.fkknv.app",
      "supportsTablet": false
    },
    "android": {
      "package": "sk.fkknv.app",
      "adaptiveIcon": {
        "backgroundColor": "#16223c"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-notifications", { "color": "#16223c" }]
    ],
    "extra": {
      "apiUrl": "https://api.fkknv.sk/api/v1"
    }
  }
}
